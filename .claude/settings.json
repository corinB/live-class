    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(credentials*)",
      "Read(secrets*)",
      "Bash(cat .env*)",
      "Bash(cat *.key)",
      "Bash(cat *.pem)",
      "Bash(cat credentials*)",
      "Bash(cat secrets*)",
      "Bash(type .env*)",
      "Bash(Get-Content .env*)",
      "Bash(more .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(Get-Content *.key)",
      "PowerShell(Get-Content *.pem)",
      "PowerShell(Get-Content credentials*)",
      "PowerShell(Get-Content secrets*)",
      "PowerShell(gc .env*)",
      "PowerShell(gc *.key)",
      "PowerShell(gc *.pem)",
      "PowerShell(gc credentials*)",
      "PowerShell(gc secrets*)",
      "PowerShell(cat .env*)",
      "PowerShell(cat *.key)",
      "PowerShell(cat *.pem)",
      "PowerShell(cat credentials*)",
      "PowerShell(cat secrets*)",
      "PowerShell(type .env*)",
      "PowerShell(type *.key)",
      "PowerShell(type *.pem)",
      "PowerShell(type credentials*)",
      "PowerShell(type secrets*)",
      "PowerShell(more .env*)",
      "PowerShell(more *.key)",
      "PowerShell(more *.pem)",
      "PowerShell(more credentials*)",
      "PowerShell(more secrets*)",
      "PowerShell(Select-String * .env*)",
      "PowerShell(sls * .env*)"

# GitHub Actions CI/CD 파이프라인 템플릿 — 빌드·테스트·컨테이너 이미지 푸시를 자동화한다
name: CI/CD Pipeline

on:
  # main 브랜치 푸시 및 PR 대상 트리거
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

env:
  IMAGE_NAME: live-class
  REGISTRY: ghcr.io

jobs:
  build-and-test:
    name: Build and Test
    runs-on: ubuntu-latest

    # 테스트에 필요한 서비스 컨테이너
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_DB: liveclass
          POSTGRES_USER: liveclass
          POSTGRES_PASSWORD: liveclass
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 5s
          --health-timeout 5s
          --health-retries 5

      redis:
        image: redis:7
        ports:
          - 6379:6379
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 5

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: "21"
          distribution: "temurin"
          cache: gradle

      - name: Grant execute permission for Gradle wrapper
        run: chmod +x live-class/gradlew

      - name: Build and run tests
        working-directory: live-class
        run: ./gradlew clean test --no-daemon
        env:
          SPRING_DATASOURCE_URL: jdbc:postgresql://localhost:5432/liveclass
          SPRING_DATASOURCE_USERNAME: liveclass
          SPRING_DATASOURCE_PASSWORD: liveclass
          SPRING_DATA_REDIS_HOST: localhost
          SPRING_DATA_REDIS_PORT: 6379

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results
          path: live-class/build/reports/tests/

  push-image:
    name: Push Container Image
    runs-on: ubuntu-latest
    needs: build-and-test
    # main 브랜치 푸시 시에만 이미지 빌드 및 게시
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'

    permissions:
      contents: read
      packages: write

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Log in to Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract metadata for Docker
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ github.repository_owner }}/${{ env.IMAGE_NAME }}

      - name: Build and push Docker image
        uses: docker/build-push-action@v5
        with:
          context: ./live-class
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}

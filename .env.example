# .env.example — Copy to .env and fill in real values.
# .env is git-ignored; never commit actual secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=liveclass
POSTGRES_PASSWORD=changeme
POSTGRES_DB=liveclass
POSTGRES_URL=jdbc:postgresql://postgres:5432/liveclass

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ── Docker Hub (deploy-only; not required for local build) ───────────────────
DOCKERHUB_USERNAME=qor7777777
IMAGE_TAG=latest

# ── Application ───────────────────────────────────────────────────────────────
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ── JVM (optional; leave empty for defaults) ─────────────────────────────────
JAVA_OPTS=

# ──────────────────────────────────────────────────────────────────────────────
# GitHub Secrets that must be registered in the repository settings:
#
#   DOCKERHUB_USERNAME  — Docker Hub 계정 이름
#   DOCKERHUB_TOKEN     — Docker Hub Access Token (read/write)
#   EC2_HOST            — EC2 퍼블릭 IP 또는 도메인
#   EC2_USER            — EC2 SSH 사용자 이름 (예: ubuntu)
#   EC2_SSH_KEY         — EC2 접속용 PEM 키 (개행 포함 전체 내용)
#   GEMINI_API_KEY      — Google AI Studio API 키 (PR 코드 리뷰 workflow용)
# ──────────────────────────────────────────────────────────────────────────────
